# Copy to .env.local and fill in. Never commit .env.local.

# Google Sheet with the itinerary (the long id in the sheet's address)
SHEET_ID=
# Optional: full address of the sheet, shown as "Open the Google Sheet" under More
NEXT_PUBLIC_SHEET_URL=
# Service-account key JSON, base64-encoded on one line. Share the sheet with the account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password, used only by `supabase db push`
SUPABASE_DB_PASSWORD=

# The two people allowed in, comma-separated. The first is person "alex", the second "sam".
ALLOWED_EMAILS=alex@example.com,sam@example.com

# Google Maps JavaScript + Places API (New) browser key, restricted to your domains
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Web push: generate the pair with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Any long random string. Vercel sends it to the cron routes as a Bearer token.
CRON_SECRET=
